{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./packages/lint/oxlint.base.jsonc"],
  "plugins": ["typescript", "import", "react", "nextjs", "jsx_a11y"],
  "rules": {
    "no-console": "warn",
    "no-inline-comments": "warn",
    "no-negated-condition": "warn",
    "no-promise-executor-return": "warn",
    "no-warning-comments": "warn",
    "require-await": "warn",
    "complexity": "warn",
    "max-classes-per-file": "warn",
    "max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 80, "skipBlankLines": true, "skipComments": true }],
    "typescript/no-non-null-assertion": "warn"
  },
  "overrides": [
    {
      "files": ["**/src/client/**"],
      "rules": {
        "quickdraw/no-raw-socket": "off",
        "quickdraw/no-untyped-client": "off",
        "quickdraw/no-manual-refetch": "off",
        "quickdraw/no-await-void-mutate": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "quickdraw/no-nested-write": "off",
        "quickdraw/no-foreign-write": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "coverage", "**/legacy-src/**", "**/generated/**"]
}
