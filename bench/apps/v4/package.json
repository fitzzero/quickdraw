{
  "name": "bench-app-v4",
  "version": "0.0.0",
  "private": true,
  "description": "The benchmark board app on the published @fitzzero/quickdraw-core 4.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "schema:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script -o prisma/schema.sql",
    "seed": "node --import tsx src/seed.ts",
    "start": "node --import tsx src/server.ts",
    "check": "prisma generate && bun run schema:sql && git diff --exit-code -- prisma/schema.sql && tsgo --noEmit"
  },
  "dependencies": {
    "@fitzzero/quickdraw-core": "4.1.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "express": "^4.18.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
