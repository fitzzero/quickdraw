// The benchmark board: one project, its members and its tasks. The runner
// seeds it from a generated workload file (see bench/src/workload.ts), so a
// later app (pack G's 5.0 app) can load identical rows.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id
  name          String
  // Service-level access, as the 4.1 README's QuickdrawUser describes it.
  serviceAccess Json?
  memberships   ProjectMember[]
  assignedTasks Task[]
}

model Project {
  id      String          @id
  name    String
  members ProjectMember[]
  tasks   Task[]
}

// The 4.1 README's "membership table" ACL pattern: role holds an access level
// ("Read" | "Moderate" | "Admin").
model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id         String   @id
  projectId  String
  status     String
  ordinal    Int
  title      String
  assigneeId String?
  // About 4 KB of text per row: the detail-sized field a board list should not ship.
  plan       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status, ordinal])
  @@index([projectId, ordinal])
}
