{
  "name": "bench",
  "version": "0.0.0",
  "private": true,
  "description": "Load scenarios and recorded baselines for quickdraw-core releases (a release tool, not a CI gate)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "node --import tsx src/runner.ts",
    "report": "node --import tsx src/render.ts",
    "schema": "node --import tsx src/write-schema.ts && oxfmt result.schema.json",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json src",
    "test": "vitest run"
  },
  "dependencies": {
    "socket.io-client": "^4.8.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.20.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=24"
  }
}
