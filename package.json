{
  "name": "quickdraw",
  "private": true,
  "description": "Workspace root for @fitzzero/quickdraw-core and its companion packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzzero/quickdraw.git"
  },
  "workspaces": [
    "packages/*",
    "bench",
    "bench/apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky && conveyor-skills link && quickdraw-skills link"
  },
  "devDependencies": {
    "@fitzzero/quickdraw-skills": "workspace:*",
    "@rallycry/conveyor-skills": "^1.0.13",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "husky": "^9.1.7",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.52.0",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.10"
}
