{
  "name": "@fitzzero/quickdraw-core",
  "version": "3.8.0",
  "description": "Fast fullstack patterns for real-time applications with Socket.io and TanStack Query",
  "keywords": [
    "fullstack",
    "react",
    "real-time",
    "socket.io",
    "tanstack-query",
    "typescript"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist",
    "eslint-plugin-quickdraw",
    "eslint-config"
  ],
  "type": "module",
  "main": "./dist/shared/index.js",
  "module": "./dist/shared/index.js",
  "types": "./dist/shared/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/shared/index.js",
      "types": "./dist/shared/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server/testing": {
      "import": "./dist/server/testing.js",
      "types": "./dist/server/testing.d.ts"
    },
    "./server/testing/prisma": {
      "import": "./dist/server/testing-prisma.js",
      "types": "./dist/server/testing-prisma.d.ts"
    },
    "./server/express": {
      "import": "./dist/server/express/index.js",
      "types": "./dist/server/express/index.d.ts"
    },
    "./client/testing": {
      "import": "./dist/client/testing.js",
      "types": "./dist/client/testing.d.ts"
    },
    "./eslint-plugin": {
      "import": "./eslint-plugin-quickdraw/index.mjs"
    },
    "./eslint-config": {
      "import": "./eslint-config/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "jose": "^5.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@prisma/client": "^5.10.0",
    "@tanstack/react-query": "^5.20.0",
    "@testing-library/react": "^14.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "@vitest/coverage-v8": "^1.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsdom": "^24.0.0",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.52.0",
    "pg": "^8.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0",
    "winston": "^3.11.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3.0",
    "@eslint/js": ">=9.0.0",
    "@prisma/client": ">=5.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "eslint": ">=9.0.0",
    "eslint-config-next": ">=16.0.0",
    "express-rate-limit": ">=8.0.0",
    "globals": ">=16.0.0",
    "pg": ">=8.0.0",
    "react": ">=18.0.0",
    "socket.io": ">=4.0.0",
    "socket.io-client": ">=4.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "@eslint/js": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "eslint-config-next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
