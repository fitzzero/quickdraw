{
  "name": "@fitzzero/quickdraw-codemod",
  "version": "5.0.0",
  "description": "Moves a quickdraw 4.x app to 5.0 (contracts, defineService, the typed client) and reports what is left to decide",
  "keywords": [
    "codemod",
    "migration",
    "quickdraw",
    "ts-morph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzzero/quickdraw.git",
    "directory": "packages/codemod"
  },
  "bin": {
    "quickdraw-codemod": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "MIGRATION.md",
    "UPGRADE-PROMPT.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src bin scripts test",
    "test": "vitest run",
    "guide:sync": "node scripts/guide-names.mjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@fitzzero/quickdraw-core": "^5.0.0",
    "@fitzzero/quickdraw-lint": "^5.0.0",
    "@tanstack/react-query": "^5.20.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "express": "^4.18.2",
    "quickdraw-core-v4": "npm:@fitzzero/quickdraw-core@4.1.0",
    "react": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.0.2",
    "vitest": "^4.0.17",
    "zod": "^4.2.0",
    "zod3": "npm:zod@^3.25.76"
  },
  "engines": {
    "node": ">=24"
  }
}
