// Design-system rules for apps built from the quickdraw template (MUI with
// translations): user-visible strings in `Button`, `Typography` and a
// `Tooltip`'s `title` go through `t("key")` or `<T>`. It extends the base
// config, so an app built from the template extends this file alone:
//
//   {
//     "extends": ["./node_modules/@fitzzero/quickdraw-lint/oxlint.template.jsonc"]
//   }
//
// (Extending both, the base first, works the same.) Like every quickdraw
// rule, these take a `baseline` option.
{
  "extends": ["./oxlint.base.jsonc"],
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "quickdraw/no-raw-button-strings": "error",
        "quickdraw/no-raw-tooltip-strings": "error",
        "quickdraw/no-raw-typography-strings": "error",
      },
    },
  ],
}
