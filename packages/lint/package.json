{
  "name": "@fitzzero/quickdraw-lint",
  "version": "5.0.0-rc.0",
  "description": "oxlint plugin, base config and baseline command for quickdraw apps",
  "keywords": [
    "lint",
    "oxlint",
    "quickdraw"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzzero/quickdraw.git",
    "directory": "packages/lint"
  },
  "bin": {
    "quickdraw-lint": "./bin/quickdraw-lint.mjs"
  },
  "files": [
    "bin",
    "plugin/index.mjs",
    "plugin/baseline.mjs",
    "plugin/lib",
    "plugin/rules",
    "oxlint.base.jsonc",
    "oxlint.template.jsonc"
  ],
  "type": "module",
  "exports": {
    ".": "./plugin/index.mjs",
    "./oxlint.base.jsonc": "./oxlint.base.jsonc",
    "./oxlint.template.jsonc": "./oxlint.template.jsonc",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ../../.oxlintrc.json plugin bin",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.52.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "oxlint": "^1.52.0"
  },
  "engines": {
    "node": ">=24"
  }
}
